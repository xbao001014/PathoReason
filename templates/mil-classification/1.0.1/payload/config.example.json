{
  "General": {
    "MODEL_NAME": "MEAN_MIL",
    "seed": 17,
    "num_classes": 2,
    "num_epochs": 1,
    "num_workers": 0,
    "best_model_metric": "macro_auc",
    "earlystop": {
      "use": false
    }
  },
  "Model": {
    "in_dim": 64,
    "dropout": 0.1,
    "act": "relu",
    "criterion": "ce",
    "optimizer": {
      "which": "adam",
      "adam_config": {
        "lr": 0.0002,
        "weight_decay": 1e-05
      }
    },
    "scheduler": {
      "which": "none",
      "warmup": 0
    }
  },
  "Dataset": {
    "dataset_csv_path": "/controlled-inputs/agent-created-train-val.csv",
    "balanced_sampler": {
      "use": false,
      "replacement": true
    }
  }
}
