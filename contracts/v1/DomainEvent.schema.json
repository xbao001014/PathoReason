{
  "$defs": {
    "LegacyResourceRef": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "pathoreason/1",
          "default": "pathoreason/1",
          "title": "Schema Version",
          "type": "string"
        },
        "adapter": {
          "enum": [
            "auto_research.experiment",
            "auto_research.task_project",
            "auto_research.evidence_file"
          ],
          "title": "Adapter",
          "type": "string"
        },
        "resource_id": {
          "minLength": 1,
          "title": "Resource Id",
          "type": "string"
        },
        "revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Revision",
          "type": "string"
        },
        "revision_kind": {
          "enum": [
            "file_sha256",
            "manifest_sha256"
          ],
          "title": "Revision Kind",
          "type": "string"
        },
        "access": {
          "const": "read_only",
          "default": "read_only",
          "title": "Access",
          "type": "string"
        }
      },
      "required": [
        "adapter",
        "resource_id",
        "revision",
        "revision_kind"
      ],
      "title": "LegacyResourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "pathoreason/1",
      "default": "pathoreason/1",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "seq": {
      "exclusiveMinimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "scope": {
      "const": "domain",
      "default": "domain",
      "title": "Scope",
      "type": "string"
    },
    "producer": {
      "enum": [
        "legacy_adapter",
        "domain_service"
      ],
      "title": "Producer",
      "type": "string"
    },
    "kind": {
      "enum": [
        "resource_observed",
        "artifact_indexed",
        "workflow_state_changed"
      ],
      "title": "Kind",
      "type": "string"
    },
    "authority_ref": {
      "$ref": "#/$defs/LegacyResourceRef"
    },
    "source_event_key": {
      "minLength": 1,
      "title": "Source Event Key",
      "type": "string"
    },
    "observed_status": {
      "minLength": 1,
      "title": "Observed Status",
      "type": "string"
    },
    "correlation_turn_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Correlation Turn Id"
    }
  },
  "required": [
    "id",
    "project_id",
    "seq",
    "occurred_at",
    "producer",
    "kind",
    "authority_ref",
    "source_event_key",
    "observed_status",
    "correlation_turn_id"
  ],
  "title": "DomainEvent",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pathoreason:contracts:v1:DomainEvent"
}
