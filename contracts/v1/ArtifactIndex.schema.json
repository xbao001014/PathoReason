{
  "$defs": {
    "LegacyResourceRef": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "pathoreason/1",
          "default": "pathoreason/1",
          "title": "Schema Version",
          "type": "string"
        },
        "adapter": {
          "enum": [
            "auto_research.experiment",
            "auto_research.task_project",
            "auto_research.evidence_file"
          ],
          "title": "Adapter",
          "type": "string"
        },
        "resource_id": {
          "minLength": 1,
          "title": "Resource Id",
          "type": "string"
        },
        "revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Revision",
          "type": "string"
        },
        "revision_kind": {
          "enum": [
            "file_sha256",
            "manifest_sha256"
          ],
          "title": "Revision Kind",
          "type": "string"
        },
        "access": {
          "const": "read_only",
          "default": "read_only",
          "title": "Access",
          "type": "string"
        }
      },
      "required": [
        "adapter",
        "resource_id",
        "revision",
        "revision_kind"
      ],
      "title": "LegacyResourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "pathoreason/1",
      "default": "pathoreason/1",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "kind": {
      "enum": [
        "document",
        "figure",
        "table",
        "report",
        "source_bundle"
      ],
      "title": "Kind",
      "type": "string"
    },
    "media_type": {
      "minLength": 1,
      "title": "Media Type",
      "type": "string"
    },
    "storage_root": {
      "enum": [
        "legacy_evidence",
        "pathoreason_artifacts"
      ],
      "title": "Storage Root",
      "type": "string"
    },
    "relative_path": {
      "minLength": 1,
      "title": "Relative Path",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "source_ref": {
      "$ref": "#/$defs/LegacyResourceRef"
    },
    "run_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/LegacyResourceRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "stage_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Stage Ref"
    },
    "verification_scope": {
      "enum": [
        "indexed",
        "bytes_verified",
        "scientifically_reviewed"
      ],
      "title": "Verification Scope",
      "type": "string"
    },
    "evidence_role": {
      "enum": [
        "development",
        "synthetic",
        "manuscript_review",
        "independent_test",
        "not_assessed"
      ],
      "title": "Evidence Role",
      "type": "string"
    }
  },
  "required": [
    "id",
    "project_id",
    "title",
    "kind",
    "media_type",
    "storage_root",
    "relative_path",
    "sha256",
    "size_bytes",
    "source_ref",
    "run_ref",
    "stage_ref",
    "verification_scope",
    "evidence_role"
  ],
  "title": "ArtifactIndex",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pathoreason:contracts:v1:ArtifactIndex"
}
