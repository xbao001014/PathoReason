{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "pathoreason/1",
      "default": "pathoreason/1",
      "title": "Schema Version",
      "type": "string"
    },
    "adapter": {
      "enum": [
        "auto_research.experiment",
        "auto_research.task_project",
        "auto_research.evidence_file"
      ],
      "title": "Adapter",
      "type": "string"
    },
    "resource_id": {
      "minLength": 1,
      "title": "Resource Id",
      "type": "string"
    },
    "revision": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Revision",
      "type": "string"
    },
    "revision_kind": {
      "enum": [
        "file_sha256",
        "manifest_sha256"
      ],
      "title": "Revision Kind",
      "type": "string"
    },
    "access": {
      "const": "read_only",
      "default": "read_only",
      "title": "Access",
      "type": "string"
    }
  },
  "required": [
    "adapter",
    "resource_id",
    "revision",
    "revision_kind"
  ],
  "title": "LegacyResourceRef",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pathoreason:contracts:v1:LegacyResourceRef"
}
