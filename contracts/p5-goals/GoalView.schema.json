{
  "properties": {
    "schema_version": {
      "const": "pathoreason.goal/1",
      "default": "pathoreason.goal/1",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "conversation_id": {
      "title": "Conversation Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "revision": {
      "title": "Revision",
      "type": "integer"
    },
    "objective": {
      "title": "Objective",
      "type": "string"
    },
    "state": {
      "enum": [
        "active",
        "paused",
        "blocked",
        "waiting_input",
        "waiting",
        "completed",
        "budget_exhausted",
        "cancelled"
      ],
      "title": "State",
      "type": "string"
    },
    "summary": {
      "default": "",
      "title": "Summary",
      "type": "string"
    },
    "next_action": {
      "default": "",
      "title": "Next Action",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "completion_criteria": {
      "items": {
        "type": "string"
      },
      "title": "Completion Criteria",
      "type": "array"
    },
    "turns_used": {
      "default": 0,
      "title": "Turns Used",
      "type": "integer"
    },
    "max_turns": {
      "default": 8,
      "title": "Max Turns",
      "type": "integer"
    },
    "last_turn_id": {
      "title": "Last Turn Id",
      "type": "string"
    },
    "evidence": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Evidence",
      "type": "array"
    },
    "completion_scope": {
      "default": "not_complete",
      "enum": [
        "not_complete",
        "answer_only",
        "evidence_bytes_verified"
      ],
      "title": "Completion Scope",
      "type": "string"
    },
    "scientific_approval": {
      "const": false,
      "default": false,
      "title": "Scientific Approval",
      "type": "boolean"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "conversation_id",
    "project_id",
    "revision",
    "objective",
    "state",
    "last_turn_id",
    "created_at",
    "updated_at"
  ],
  "title": "GoalView",
  "type": "object"
}
