{
  "$defs": {
    "GoalBlocker": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "platform",
            "permission",
            "input",
            "resource"
          ],
          "title": "Kind",
          "type": "string"
        },
        "capability": {
          "anyOf": [
            {
              "const": "training_execution",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability"
        },
        "required_action": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Required Action",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "required_action"
      ],
      "title": "GoalBlocker",
      "type": "object"
    },
    "GoalEvidence": {
      "additionalProperties": false,
      "properties": {
        "artifact_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 10,
          "title": "Artifact Ids",
          "type": "array"
        },
        "files": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Files",
          "type": "array"
        },
        "task_check_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Task Check Ids",
          "type": "array"
        }
      },
      "title": "GoalEvidence",
      "type": "object"
    },
    "GoalWait": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "synthetic_run",
          "title": "Kind",
          "type": "string"
        },
        "run_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "run_id"
      ],
      "title": "GoalWait",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "turn_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Turn Id",
      "type": "string"
    },
    "grant": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Grant",
      "type": "string"
    },
    "expected_revision": {
      "minimum": 1,
      "title": "Expected Revision",
      "type": "integer"
    },
    "outcome": {
      "enum": [
        "continue",
        "completed",
        "needs_input",
        "blocked",
        "paused",
        "waiting",
        "cancelled"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "summary": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "next_action": {
      "default": "",
      "maxLength": 1200,
      "title": "Next Action",
      "type": "string"
    },
    "completion_criteria": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Completion Criteria",
      "type": "array"
    },
    "evidence": {
      "$ref": "#/$defs/GoalEvidence"
    },
    "answer_only": {
      "default": false,
      "title": "Answer Only",
      "type": "boolean"
    },
    "wait_for": {
      "anyOf": [
        {
          "$ref": "#/$defs/GoalWait"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "blocker": {
      "anyOf": [
        {
          "$ref": "#/$defs/GoalBlocker"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "turn_id",
    "grant",
    "expected_revision",
    "outcome",
    "summary"
  ],
  "title": "GoalCheckpoint",
  "type": "object"
}
