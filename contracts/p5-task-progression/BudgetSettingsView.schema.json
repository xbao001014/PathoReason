{
  "$defs": {
    "GoalBlocker": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "platform",
            "permission",
            "input",
            "resource"
          ],
          "title": "Kind",
          "type": "string"
        },
        "capability": {
          "anyOf": [
            {
              "const": "training_execution",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability"
        },
        "required_action": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Required Action",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "required_action"
      ],
      "title": "GoalBlocker",
      "type": "object"
    },
    "GoalView": {
      "properties": {
        "schema_version": {
          "const": "pathoreason.goal/1",
          "default": "pathoreason.goal/1",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "conversation_id": {
          "title": "Conversation Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
        "objective": {
          "title": "Objective",
          "type": "string"
        },
        "state": {
          "enum": [
            "active",
            "paused",
            "blocked",
            "waiting_input",
            "waiting",
            "completed",
            "budget_exhausted",
            "cancelled"
          ],
          "title": "State",
          "type": "string"
        },
        "blocker": {
          "anyOf": [
            {
              "$ref": "#/$defs/GoalBlocker"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "next_action": {
          "default": "",
          "title": "Next Action",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "completion_criteria": {
          "items": {
            "type": "string"
          },
          "title": "Completion Criteria",
          "type": "array"
        },
        "turns_used": {
          "default": 0,
          "title": "Turns Used",
          "type": "integer"
        },
        "max_turns": {
          "default": 8,
          "title": "Max Turns",
          "type": "integer"
        },
        "last_turn_id": {
          "title": "Last Turn Id",
          "type": "string"
        },
        "evidence": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Evidence",
          "type": "array"
        },
        "completion_scope": {
          "default": "not_complete",
          "enum": [
            "not_complete",
            "answer_only",
            "evidence_bytes_verified"
          ],
          "title": "Completion Scope",
          "type": "string"
        },
        "scientific_approval": {
          "const": false,
          "default": false,
          "title": "Scientific Approval",
          "type": "boolean"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        },
        "continued_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Continued From"
        },
        "continued_in": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Continued In"
        },
        "limit_revision": {
          "default": 0,
          "title": "Limit Revision",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "conversation_id",
        "project_id",
        "revision",
        "objective",
        "state",
        "last_turn_id",
        "created_at",
        "updated_at"
      ],
      "title": "GoalView",
      "type": "object"
    },
    "StudyBudget": {
      "additionalProperties": false,
      "properties": {
        "max_turns": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Turns",
          "type": "integer"
        },
        "max_wall_seconds": {
          "maximum": 86400,
          "minimum": 60,
          "title": "Max Wall Seconds",
          "type": "integer"
        },
        "max_turn_wall_seconds": {
          "default": 86400,
          "maximum": 604800,
          "minimum": 60,
          "title": "Max Turn Wall Seconds",
          "type": "integer"
        }
      },
      "required": [
        "max_turns",
        "max_wall_seconds"
      ],
      "title": "StudyBudget",
      "type": "object"
    },
    "StudyView": {
      "properties": {
        "schema_version": {
          "const": "pathoreason.study/1",
          "default": "pathoreason.study/1",
          "title": "Schema Version",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "workspace": {
          "title": "Workspace",
          "type": "string"
        },
        "budget": {
          "$ref": "#/$defs/StudyBudget"
        },
        "used_turns": {
          "title": "Used Turns",
          "type": "integer"
        },
        "used_wall_seconds": {
          "title": "Used Wall Seconds",
          "type": "number"
        },
        "used_budget_seconds": {
          "default": 0,
          "title": "Used Budget Seconds",
          "type": "number"
        },
        "excluded_tool_seconds": {
          "default": 0,
          "title": "Excluded Tool Seconds",
          "type": "number"
        },
        "legacy_wall_seconds": {
          "default": 0,
          "title": "Legacy Wall Seconds",
          "type": "number"
        },
        "phase": {
          "default": "prepared",
          "title": "Phase",
          "type": "string"
        },
        "scientific_approval": {
          "const": false,
          "default": false,
          "title": "Scientific Approval",
          "type": "boolean"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        },
        "budget_revision": {
          "default": 0,
          "title": "Budget Revision",
          "type": "integer"
        }
      },
      "required": [
        "project_id",
        "workspace",
        "budget",
        "used_turns",
        "used_wall_seconds",
        "revision"
      ],
      "title": "StudyView",
      "type": "object"
    }
  },
  "properties": {
    "project": {
      "$ref": "#/$defs/StudyView"
    },
    "goal": {
      "anyOf": [
        {
          "$ref": "#/$defs/GoalView"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "history": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "History",
      "type": "array"
    }
  },
  "required": [
    "project"
  ],
  "title": "BudgetSettingsView",
  "type": "object"
}
