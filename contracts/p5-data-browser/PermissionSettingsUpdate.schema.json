          "enum": [
            "allow",
            "ask",
            "deny"
          ],
          "title": "Edit",
          "type": "string"
        },
        "webfetch": {
          "default": "ask",
          "enum": [
            "allow",
            "ask",
            "deny"
          ],
          "title": "Webfetch",
          "type": "string"
        },
        "external_directory": {
          "default": "ask",
          "enum": [
            "allow",
            "ask",
            "deny"
