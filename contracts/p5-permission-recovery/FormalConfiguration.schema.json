    "ModelDescriptor": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "pathoreason/1",
          "default": "pathoreason/1",
          "title": "Schema Version",
          "type": "string"
        },
        "runtime": {
          "enum": [
            "codex",
            "opencode"
          ],
