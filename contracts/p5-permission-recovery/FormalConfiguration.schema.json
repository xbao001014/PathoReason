    "FormalPolicy": {
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "enum": [
            "codex",
            "opencode"
          ],
          "title": "Runtime",
          "type": "string"
        },
        "environment": {
          "enum": [
            "local",
            "bxn-server"
          ],
          "title": "Environment",
          "type": "string"
        },
        "execution_mode": {
          "const": "research",
          "default": "research",
          "title": "Execution Mode",
          "type": "string"
        },
        "max_turns": {
          "minimum": 1,
          "title": "Max Turns",
          "type": "integer"
        },
        "max_wall_seconds": {
          "exclusiveMinimum": 0,
          "title": "Max Wall Seconds",
          "type": "number"
        },
        "concurrency": {
          "const": 1,
          "default": 1,
          "title": "Concurrency",
          "type": "integer"
        },
        "automatic_retries": {
          "const": 0,
          "default": 0,
          "title": "Automatic Retries",
          "type": "integer"
        }
