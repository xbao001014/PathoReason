    "execution_scope": {
      "default": "standard",
      "enum": [
        "standard",
        "dialogue",
        "inspection"
      ],
      "title": "Execution Scope",
      "type": "string"
    },
    "goal_execution_scope": {
      "anyOf": [
        {
          "enum": [
            "standard",
            "dialogue",
            "inspection"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Goal Execution Scope"
