      "title": "Opencode"
    },
    "runtime": {
      "enum": [
        "codex",
        "opencode"
      ],
      "title": "Runtime",
      "type": "string"
    },
    "environment": {
      "enum": [
        "local",
        "bxn-server"
      ],
      "title": "Environment",
      "type": "string"
    },
    "context_policy": {
      "const": "native_compaction_with_authoritative_project_reload",
