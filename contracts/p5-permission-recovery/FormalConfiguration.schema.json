  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "pathoreason.runtime-config/2",
      "default": "pathoreason.runtime-config/2",
      "title": "Schema Version",
      "type": "string"
    },
    "execution_mode": {
      "const": "research",
      "default": "research",
      "title": "Execution Mode",
      "type": "string"
    },
    "business_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/BusinessView"
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "agent": {
      "const": "pathoreason-formal",
      "default": "pathoreason-formal",
      "title": "Agent",
      "type": "string"
    },
    "skill": {
      "anyOf": [
        {
          "$ref": "#/$defs/SkillDefinition"
        },
        {
          "type": "null"
        }
      ]
    },
    "opencode": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
