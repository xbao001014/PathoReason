      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Codex"
    },
    "native_config_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Native Config Digest"
    },
    "reasoning_effort": {
      "anyOf": [
        {
          "enum": [
            "none",
            "low",
            "high",
            "max"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reasoning Effort"
    },
    "study_revision": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Study Revision",
      "type": "string"
    },
    "study_budget_revision": {
      "default": 0,
      "title": "Study Budget Revision",
      "type": "integer"
    },
    "permission_settings": {
      "anyOf": [
        {
          "$ref": "#/$defs/PermissionSettings"
        },
        {
          "type": "null"
        }
      ],
      "default": null
