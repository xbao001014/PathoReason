        "id",
        "version",
        "title",
        "description",
        "input_schema_ref",
        "output_schema_ref",
        "instruction_refs",
        "capability_refs",
        "workflow_template_refs",
        "runtime_support",
        "required_inputs",
        "required_tools",
        "implementation_status",
        "evidence_scope",
        "runtime_readiness",
        "unavailable_reason",
        "digest"
