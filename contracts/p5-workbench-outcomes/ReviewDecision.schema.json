{
  "$defs": {
    "IssueDecision": {
      "additionalProperties": false,
      "properties": {
        "issue_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Issue Id",
          "type": "string"
        },
        "decision": {
          "enum": [
            "accept",
            "modify",
            "reject",
            "defer"
          ],
          "title": "Decision",
          "type": "string"
        },
        "rationale": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "issue_id",
        "decision",
        "rationale"
      ],
      "title": "IssueDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "request_key": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Request Key",
      "type": "string"
    },
    "expected_revision": {
      "minimum": 0,
      "title": "Expected Revision",
      "type": "integer"
    },
    "action": {
      "enum": [
        "approve",
        "revise",
        "clarify",
        "reopen"
      ],
      "title": "Action",
      "type": "string"
    },
    "comment": {
      "default": "",
      "maxLength": 8000,
      "title": "Comment",
      "type": "string"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/IssueDecision"
      },
      "maxItems": 40,
      "title": "Issues",
      "type": "array"
    },
    "target_gate": {
      "anyOf": [
        {
          "enum": [
            "blueprint",
            "draft",
            "review",
            "scientific",
            "delivery"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Gate"
    },
    "confirm_answers": {
      "default": false,
      "description": "Explicit user confirmation that the comment answers the pending blueprint questions and approves that plan with these answers. Does not waive integrity checks or approve later manuscript content.",
      "title": "Confirm Answers",
      "type": "boolean"
    }
  },
  "required": [
    "request_key",
    "expected_revision",
    "action"
  ],
  "title": "ReviewDecision",
  "type": "object"
}
