{
  "$defs": {
    "PresentationChange": {
      "additionalProperties": false,
      "properties": {
        "original_artifact_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Original Artifact Id",
          "type": "string"
        },
        "revised_artifact_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Revised Artifact Id",
          "type": "string"
        },
        "description": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "original_artifact_id",
        "revised_artifact_id",
        "description"
      ],
      "title": "PresentationChange",
      "type": "object"
    },
    "ReviewIssue": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "finding": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Finding",
          "type": "string"
        },
        "location": {
          "default": "",
          "maxLength": 300,
          "title": "Location",
          "type": "string"
        },
        "blocking": {
          "default": false,
          "title": "Blocking",
          "type": "boolean"
        },
        "resolved": {
          "default": false,
          "title": "Resolved",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "finding"
      ],
      "title": "ReviewIssue",
      "type": "object"
    },
    "ReviewMaterial": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "artifact_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Artifact Id",
          "type": "string"
        }
      },
      "required": [
        "role",
        "label",
        "artifact_id"
      ],
      "title": "ReviewMaterial",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "gate": {
      "enum": [
        "blueprint",
        "draft",
        "review",
        "scientific",
        "delivery"
      ],
      "title": "Gate",
      "type": "string"
    },
    "expected_revision": {
      "minimum": 0,
      "title": "Expected Revision",
      "type": "integer"
    },
    "summary": {
      "maxLength": 1800,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "materials": {
      "items": {
        "$ref": "#/$defs/ReviewMaterial"
      },
      "maxItems": 24,
      "minItems": 1,
      "title": "Materials",
      "type": "array"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/ReviewIssue"
      },
      "maxItems": 40,
      "title": "Issues",
      "type": "array"
    },
    "author_questions": {
      "items": {
        "type": "string"
      },
      "maxItems": 12,
      "title": "Author Questions",
      "type": "array"
    },
    "changes": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Changes",
      "type": "array"
    },
    "key_findings": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Key Findings",
      "type": "array"
    },
    "key_limitations": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Key Limitations",
      "type": "array"
    },
    "audit_status": {
      "default": "not_applicable",
      "enum": [
        "not_applicable",
        "passed",
        "blocked"
      ],
      "title": "Audit Status",
      "type": "string"
    },
    "audited_manuscript_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audited Manuscript Sha256"
    },
    "presentation_only": {
      "default": false,
      "title": "Presentation Only",
      "type": "boolean"
    },
    "presentation_changes": {
      "items": {
        "$ref": "#/$defs/PresentationChange"
      },
      "maxItems": 24,
      "title": "Presentation Changes",
      "type": "array"
    },
    "scientific_basis_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scientific Basis Digest"
    }
  },
  "required": [
    "gate",
    "expected_revision",
    "summary",
    "materials"
  ],
  "title": "ReviewRequest",
  "type": "object"
}
