{
  "additionalProperties": false,
  "properties": {
    "stage_id": {
      "enum": [
        "data",
        "baseline",
        "innovation",
        "analysis",
        "manuscript"
      ],
      "title": "Stage Id",
      "type": "string"
    },
    "workflow_revision": {
      "minimum": 1,
      "title": "Workflow Revision",
      "type": "integer"
    },
    "summary": {
      "maxLength": 1600,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "decisions": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Decisions",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "open_questions": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Open Questions",
      "type": "array"
    },
    "next_action": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Next Action",
      "type": "string"
    },
    "training_run_ids": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "maxItems": 12,
      "title": "Training Run Ids",
      "type": "array"
    }
  },
  "required": [
    "stage_id",
    "workflow_revision",
    "summary",
    "limitations",
    "next_action"
  ],
  "title": "StageHandoff",
  "type": "object"
}
